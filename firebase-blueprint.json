        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "actorName", "role", "action", "details", "timestamp"]
    },
    "customers": {
      "title": "Customers",
      "description": "Registered and walk-in customer directory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
