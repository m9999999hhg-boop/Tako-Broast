        "updatedAt": { "type": "string" }
      },
      "required": ["id", "orderNumber", "orderType", "status", "total", "createdAt"]
    },
    "products": {
      "title": "Products",
      "description": "Menu meals and items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nameAr": { "type": "string" },
        "nameEn": { "type": "string" },
        "price": { "type": "number" },
        "categoryId": { "type": "string" },
