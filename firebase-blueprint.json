        "totalSpent": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "phone"]
    },
    "settings": {
      "title": "Settings",
      "description": "Restaurant branch details and operational configurations",
      "type": "object",
      "properties": {
        "restaurantNameAr": { "type": "string" },
        "hotline": { "type": "string" },
        "autoPrintEnabled": { "type": "boolean" },
        "audioAlertsEnabled": { "type": "boolean" },
        "taxRate": { "type": "number" },
        "defaultDeliveryFee": { "type": "number" }
      }
