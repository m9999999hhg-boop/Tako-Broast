        "hasSpicyOption": { "type": "boolean" },
        "descriptionAr": { "type": "string" }
      },
      "required": ["id", "nameAr", "price", "isAvailable"]
    },
    "categories": {
      "title": "Categories",
      "description": "Food menu categories",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nameAr": { "type": "string" },
        "nameEn": { "type": "string" },
        "icon": { "type": "string" }
      },
      "required": ["id", "nameAr"]
    },
    "users": {
      "title": "Staff Users",
      "description": "Restaurant staff accounts with roles and permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "role", "active"]
    },
    "activityLogs": {
      "title": "Activity Logs",
      "description": "Audit trail of staff operations and system events without exposing passwords or sensitive credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actorName": { "type": "string" },
        "role": { "type": "string" },
