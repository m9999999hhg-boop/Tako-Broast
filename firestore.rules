rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Categories: public read, staff write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Products: public read, staff write
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: public read/create, staff manage
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.total >= 0;
      allow update, delete: if true;
    }

    // Customers: directory access
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Staff Accounts: manage staff
    match /users/{userId} {
      allow read, write: if true;
    }

    // Activity Logs: audit trail
    match /activityLogs/{logId} {
      allow read: if true;
      allow create: if request.resource.data.action is string;
      allow update, delete: if false; // Immutable audit log!
    }

    // Restaurant Settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Print Jobs
    match /printJobs/{jobId} {
      allow read, write: if true;
    }
  }
}
